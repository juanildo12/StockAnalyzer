rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: each user can read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Alerted symbols: each user can read/write their own
    match /alerted/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Portfolios: each user can read/write their own
    match /portfolios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Watchlists: each user can read/write their own
    match /watchlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
